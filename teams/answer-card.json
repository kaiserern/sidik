{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "text": "Penyebab: ${sidik}",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Keyakinan: ${confidence}",
      "isSubtle": true,
      "spacing": "None",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${reason}",
      "wrap": true,
      "separator": true
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Pemilik", "value": "${owner}" },
        { "title": "Channel", "value": "#${channel}" },
        { "title": "Sebaran", "value": "${counts}" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${evidence}",
      "fontType": "Monospace",
      "size": "Small",
      "wrap": true,
      "separator": true
    }
  ]
}
