# Loki. Tanpa ini, pakai --replay.
LOKI_URL=http://localhost:3100

# Nama job worker di Loki.
LOKI_JOB_REGEX=worker-.+

# Zona waktu untuk jam log.
DISPLAY_TZ=Asia/Jakarta

# Bagian LLM. Biarkan kosong kalau cukup jalan tanpa model.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Hitungan "berapa orang yang lapor hal serupa". Boleh dikosongkan.
SIDIK_DB=sidik.db
